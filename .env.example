# All settings are optional. Local development works without credentials.
# Copy only the settings you need into .env.local. Never commit real secrets.

# Server-only GitHub token used by lib/sponsors.ts to read sponsor data.
# GITHUB_SPONSORS_TOKEN=

# Shared secret for signed sponsorship webhooks at /api/sponsors.
# GITHUB_SPONSORS_WEBHOOK_SECRET=

# Absolute URL used for page metadata; defaults to https://cloverui.xyz.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
